API_ID=12345678
API_HASH=replace_with_api_hash
SESSION_NAME=telegram_client

# Сервер доступен только локально. Для внешнего адреса ACCESS_TOKEN обязателен.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
# ACCESS_TOKEN=replace_with_a_long_random_value

AUTH_ATTEMPT_TTL_SECONDS=600
MAX_UPLOAD_BYTES=33554432
MEDIA_CACHE_DIR=data/media-cache
MAX_MEDIA_BYTES=67108864
